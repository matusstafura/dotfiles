# -------------------------------------
# powerlevel10k (MUST BE FIRST)
# -------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# keep PATH free of duplicates (re-sourcing with `drz` won't grow it)
typeset -U path

# -------------------------------------
# nvim
# -------------------------------------
export EDITOR=/usr/local/bin/nvim

# -------------------------------------
# nvm
# -------------------------------------
export NVM_DIR="$HOME/.nvm"
# lazy-load: put the newest installed node on PATH now, load nvm on first `nvm` call
_nvm_node_bin=(${NVM_DIR}/versions/node/v*(N/On[1]))
[ -n "$_nvm_node_bin" ] && export PATH="$_nvm_node_bin/bin:$PATH"
unset _nvm_node_bin
nvm() {
  unset -f nvm
  [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
  [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
  nvm "$@"
}

# -------------------------------------
# powerlevel10k config
# -------------------------------------
ZSH_THEME="powerlevel10k/powerlevel10k"
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# -------------------------------------
# load custom dotfiles
# -------------------------------------
[ -f ~/dotfiles/.aliases ] && source ~/dotfiles/.aliases
[ -f ~/dotfiles/scripts/scripts ] && source ~/dotfiles/scripts/scripts
[ -f ~/dotfiles/scripts/aes ] && source ~/dotfiles/scripts/aes
[ -f ~/dotfiles/scripts/tts ] && source ~/dotfiles/scripts/tts

# -------------------------------------
# zsh
# -------------------------------------
export ZSH=~/.oh-my-zsh
source $ZSH/oh-my-zsh.sh

# Don't save commands that start with a space
setopt HIST_IGNORE_SPACE

# -------------------------------------
# fzf 
# -------------------------------------
eval "$(fzf --zsh)"
bindkey -s ^f 'fzf\n'
bindkey -s ^n "source ~/dotfiles/scripts/tmux-sessionizer\n"

# -------------------------------------
# PATHS
# -------------------------------------
export PATH="/usr/local/sbin:$PATH"
export PATH="/usr/local/bin:$PATH"
# export PATH="/usr/local/opt/php@8.1/bin:$PATH"
# export PATH="/usr/local/opt/php@8.1/sbin:$PATH"
export PATH="/usr/local/opt/icu4c/bin:$PATH"
export PATH="/usr/local/opt/icu4c/sbin:$PATH"
export PATH=~/.composer/vendor/bin:$PATH
export GOPATH=$HOME/go
export PATH=$PATH:$GOPATH/bin
export PATH="/usr/local/opt/llvm/bin:$PATH"

# Herd
export PATH="$HOME/Library/Application Support/Herd/bin/":$PATH
for v in 81 82 83 84 85; do
  export "HERD_PHP_${v}_INI_SCAN_DIR=$HOME/Library/Application Support/Herd/config/php/$v/"
done

# Turso
export PATH="$PATH:$HOME/.turso"
